#!/bin/sh

set -e

# Switch LightDM to the Zyphor web greeter theme.
#
# lightdm-webkit2-greeter is not in kali-rolling, so it may or may not be part
# of a given image (it is pulled in by hand or by a local package). Selecting a
# greeter-session that does not exist leaves a machine with no usable login
# screen, so only write the override when the greeter is really present.

GREETER_DESKTOP=/usr/share/xgreeters/lightdm-webkit2-greeter.desktop
THEME_DIR=/usr/share/lightdm-webkit/themes/zyphor
CONF_DIR=/etc/lightdm/lightdm.conf.d
CONF_FILE="$CONF_DIR/60_zyphor-greeter.conf"

if [ -f "$GREETER_DESKTOP" ] && [ -f "$THEME_DIR/index.html" ]; then
    mkdir -p "$CONF_DIR"
    cat > "$CONF_FILE" <<'EOF'
# Generated by hooks/live/zyphor-greeter-session.chroot
[Seat:*]
greeter-session=lightdm-webkit2-greeter
EOF
    echo "zyphor-greeter: web greeter found, using the zyphor login theme"
else
    rm -f "$CONF_FILE"
    echo "zyphor-greeter: lightdm-webkit2-greeter not installed, keeping lightdm-gtk-greeter"
fi
